<Project Sdk="Microsoft.NET.Sdk">
  <!-- No test framework package: the slice has no dependencies. `dotnet run --project tests/BadDay.Tests`
       runs every test and exits non-zero on any failure. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\BadDay.Core\BadDay.Core.csproj" />
    <ProjectReference Include="..\..\src\BadDay.Cli\BadDay.Cli.csproj" />
  </ItemGroup>
</Project>
