<Project Sdk="Godot.NET.Sdk/4.7.2">
  <!-- The Godot client: presentation and input over BodyPainBoxSession. Building it builds Lodur, Ymir (cmake and a C compiler) and BDS into .godot/mono/temp/bin/Debug. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <AssemblyName>BadDay.Client</AssemblyName>
    <RootNamespace>BadDay.Client</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\src\BadDay.Ymir\BadDay.Ymir.csproj" />
  </ItemGroup>
</Project>
