; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Bad Day Simulator"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "C#")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="BadDay.Client"

[physics]

; Godot's physics is switched off: Ymir is the only physics world. The client ticks BodyPainBoxSession at 120 Hz.
3d/physics_engine="Dummy"
common/physics_ticks_per_second=120
common/physics_interpolation=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[shader_globals]

ps1_res={
"type": "vec2",
"value": Vector2(426.667, 240)
}
ps1_key_dir={
"type": "vec3",
"value": Vector3(-0.4, 0.8, 0.45)
}
ps1_key_color={
"type": "vec3",
"value": Vector3(0.95, 0.9, 0.82)
}
ps1_ambient={
"type": "vec3",
"value": Vector3(0.3, 0.34, 0.42)
}
ps1_fog_color={
"type": "vec3",
"value": Vector3(0.1, 0.1, 0.11)
}
ps1_fog_near={
"type": "float",
"value": 4.0
}
ps1_fog_far={
"type": "float",
"value": 14.0
}
ps1_glow_pos={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
ps1_glow_color={
"type": "vec3",
"value": Vector3(0.85, 0.95, 1)
}
ps1_glow_energy={
"type": "float",
"value": 0.0
}
